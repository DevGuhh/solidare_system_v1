generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                  Int                  @id @default(autoincrement())
  nome                String
  email               String               @unique
  senhaHash           String
  role                RoleUsuario          @default(INSTITUICAO)
  ativo               Boolean              @default(true)
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt
  instituicaoId       Int?                 @unique
  senhaProvisoria     Boolean              @default(false)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  doacoes             Doacao[]
  instituicao         InstituicaoParceira? @relation(fields: [instituicaoId], references: [id])
  historicoRegistrado HistoricoBeneficiario[]
  movimentacoesSaldo MovimentacaoSaldo[]

  @@index([resetTokenHash])
  @@map("usuarios")
}

model InstituicaoParceira {
  id            Int               @id @default(autoincrement())
  nome          String
  tipo          TipoInstituicao   @default(OUTRO)
  responsavel   String
  telefone      String
  endereco      String
  cep           String?
  logradouro    String?
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String
  uf            String?
  statusOk      StatusInstituicao @default(PENDENTE)
  ativa         Boolean           @default(true)
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt
  email         String            @unique
  deletedAt     DateTime?
  beneficiarios Beneficiario[]
  doacoes       Doacao[]
  usuario       Usuario?
  saldoCesta SaldoCesta?

  @@map("instituicoes_parceiras")
}

model Beneficiario {
  id                     Int                 @id @default(autoincrement())
  nomeCompleto           String
  cpf                    String              @unique
  dataNascimento         DateTime
  logradouro             String
  numero                 String
  complemento            String?
  cep                    String?
  regiao                 String
  cidade                 String
  uf                     String
  telefonePrincipal      String
  telefoneSecundario     String?
  email                  String?
  instituicaoId          Int
  tipoBeneficio          TipoBeneficio       @default(CESTA)
  situacaoSocioeconomica String?
  dataCadastro           DateTime            @default(now())
  observacoes            String?
  ativo                  Boolean             @default(true)
  criadoEm               DateTime            @default(now())
  atualizadoEm           DateTime            @updatedAt
  deletedAt              DateTime?
  composicaoFamiliar     Int                 @default(1)
  instituicao            InstituicaoParceira @relation(fields: [instituicaoId], references: [id])
  doacoes                Doacao[]
  qrcodes                QRCode[]
  historico              HistoricoBeneficiario[]

  @@index([instituicaoId])
  @@map("beneficiarios")
}

model HistoricoBeneficiario {
  id             Int                    @id @default(autoincrement())
  beneficiarioId Int
  tipo           TipoEventoHistorico
  descricao      String
  detalhes       Json?
  usuarioId      Int?
  criadoEm       DateTime               @default(now())

  beneficiario   Beneficiario           @relation(fields: [beneficiarioId], references: [id])
  usuario        Usuario?               @relation(fields: [usuarioId], references: [id])

  @@index([beneficiarioId])
  @@index([beneficiarioId, criadoEm])
  @@map("historico_beneficiarios")
}


model Doacao {
  id             Int                 @id @default(autoincrement())
  codigo         String              @unique
  beneficiarioId Int
  instituicaoId  Int
  tipo           TipoBeneficio
  quantidade     Int
  observacoes    String?
  comprovante    Boolean             @default(false)
  dataDoacao     DateTime            @default(now())
  criadoEm       DateTime            @default(now())
  atualizadoEm   DateTime            @updatedAt
  deletedAt      DateTime?
  usuarioId      Int
  movimentacoesSaldo MovimentacaoSaldo[]
  beneficiario   Beneficiario        @relation(fields: [beneficiarioId], references: [id])
  instituicao    InstituicaoParceira @relation(fields: [instituicaoId], references: [id])
  usuario        Usuario             @relation(fields: [usuarioId], references: [id])
  


  @@index([beneficiarioId])
  @@index([instituicaoId])
  @@index([usuarioId])
  @@index([dataDoacao])
  @@index([instituicaoId, dataDoacao])
  @@map("doacoes")
}

model QRCode {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique
  beneficiarioId Int
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])

  @@index([beneficiarioId])
  @@index([ativo])
  @@map("qrcodes")
}

model SaldoCesta {
  id            Int      @id @default(autoincrement())
  instituicaoId Int      @unique
  saldoAtual    Int      @default(0)
  atualizadoEm  DateTime @updatedAt

  instituicao   InstituicaoParceira @relation(fields: [instituicaoId], references: [id])
  movimentacoes MovimentacaoSaldo[]

  @@map("saldos_cesta")
}

model MovimentacaoSaldo {
  id             Int                    @id @default(autoincrement())
  saldoCestaId   Int
  tipo           TipoMovimentacaoSaldo
  quantidade     Int
  saldoAnterior  Int
  saldoPosterior Int
  doacaoId       Int?
  usuarioId      Int
  observacao     String?
  criadoEm       DateTime               @default(now())

  saldoCesta SaldoCesta @relation(fields: [saldoCestaId], references: [id])
  doacao     Doacao?    @relation(fields: [doacaoId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([saldoCestaId, criadoEm])
  @@index([doacaoId])
  @@map("movimentacoes_saldo")
}


enum RoleUsuario {
  ADMIN
  INSTITUICAO
}

enum TipoInstituicao {
  IGREJA
  ASSOCIACAO
  ONG
  OUTRO
}

enum StatusInstituicao {
  OK
  PENDENTE
}

enum TipoBeneficio {
  CESTA
  GRANEL
  AMBOS
}

enum TipoEventoHistorico {
  CADASTRO
  ATUALIZACAO
  DOACAO
}

enum TipoMovimentacaoSaldo {
  ENTRADA
  SAIDA_DOACAO
  ESTORNO_DOACAO
}

