generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                  Int         @id @default(autoincrement())
  nome                String
  email               String      @unique
  senhaHash           String
  role                RoleUsuario @default(INSTITUICAO)
  ativo               Boolean     @default(true)
  criadoEm            DateTime    @default(now())
  atualizadoEm        DateTime    @updatedAt
  instituicaoId       Int?        @unique
  senhaProvisoria     Boolean     @default(false)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  doacoes             Doacao[] @relation("DoacaoCriadaPor")
  doacoesCanceladas   Doacao[] @relation("DoacaoCanceladaPor")
  historicoRegistrado HistoricoBeneficiario[]
  movimentacoesSaldo  MovimentacaoSaldo[]
  instituicao         InstituicaoParceira?    @relation(fields: [instituicaoId], references: [id])

  @@index([resetTokenHash])
  @@map("usuarios")
}

model InstituicaoParceira {
  id           Int               @id @default(autoincrement())
  nome         String
  tipo         TipoInstituicao   @default(OUTRO)
  responsavel  String
  telefone     String
  endereco     String
  cidade       String
  statusOk     StatusInstituicao @default(PENDENTE)
  ativa        Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  email        String            @unique
  deletedAt    DateTime?
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  uf           String?

  beneficiarios Beneficiario[]
  doacoes       Doacao[]
  saldoCesta    SaldoCesta?
  usuario       Usuario?
  cnpj          String?        @unique
  comprovantes  Comprovante[]
  notificacoes  Notificacao[]
  chamadosSuporte ChamadoSuporte[]

  @@map("instituicoes_parceiras")
}

model Beneficiario {
  id                     Int           @id @default(autoincrement())
  nomeCompleto           String
  cpf                    String        @unique
  dataNascimento         DateTime
  logradouro             String?
  numero                 String?
  complemento            String?
  cep                    String?
  regiao                 String?
  cidade                 String?
  uf                     String?
  telefonePrincipal      String?
  telefoneSecundario     String?
  email                  String?
  instituicaoId          Int?
  tipoBeneficio          TipoBeneficio @default(CESTA)
  situacaoSocioeconomica String?
  dataCadastro           DateTime      @default(now())
  observacoes            String?
  ativo                  Boolean       @default(true)
  criadoEm               DateTime      @default(now())
  atualizadoEm           DateTime      @updatedAt
  deletedAt              DateTime?
  composicaoFamiliar     Int           @default(1)
  fotoPerfil             Bytes?
  fotoPerfilMimeType     String?

  instituicao InstituicaoParceira?    @relation(fields: [instituicaoId], references: [id])
  doacoes     Doacao[]
  historico   HistoricoBeneficiario[]
  qrcodes     QRCode[]

  @@index([instituicaoId])
  @@map("beneficiarios")
}

model HistoricoBeneficiario {
  id             Int                 @id @default(autoincrement())
  beneficiarioId Int
  tipo           TipoEventoHistorico
  descricao      String
  detalhes       Json?
  usuarioId      Int?
  criadoEm       DateTime            @default(now())

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([beneficiarioId])
  @@index([beneficiarioId, criadoEm])
  @@map("historico_beneficiarios")
}

model Doacao {
  id             Int           @id @default(autoincrement())
  codigo         String        @unique
  beneficiarioId Int
  instituicaoId  Int
  tipo           TipoBeneficio
  quantidade     Int
  observacoes    String?
  comprovante    Boolean       @default(false)
  dataDoacao     DateTime      @default(now())
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt
  deletedAt      DateTime?
  usuarioId      Int
  origem         String        @default("MANUAL")
  composicaoFamiliarSnapshot Int?
  quantidadeCalculada Boolean  @default(false)
  canceladaEm    DateTime?
  motivoCancelamento String?
  canceladaPorId Int?

  beneficiario       Beneficiario        @relation(fields: [beneficiarioId], references: [id])
  instituicao        InstituicaoParceira @relation(fields: [instituicaoId], references: [id])
  usuario            Usuario             @relation("DoacaoCriadaPor", fields: [usuarioId], references: [id])
  canceladaPor        Usuario?            @relation("DoacaoCanceladaPor", fields: [canceladaPorId], references: [id])
  movimentacoesSaldo MovimentacaoSaldo[]
  comprovanteEntrega ComprovanteEntrega?
  comprovantes       Comprovante[]
  notificacoes       Notificacao[]

  @@index([beneficiarioId])
  @@index([instituicaoId])
  @@index([usuarioId])
  @@index([canceladaPorId])
  @@index([origem])
  @@index([dataDoacao])
  @@index([instituicaoId, dataDoacao])
  @@map("doacoes")
}

model ComprovanteEntrega {
  id       Int      @id @default(autoincrement())
  doacaoId Int      @unique
  foto     Bytes
  mimeType String
  tamanho  Int
  criadoEm DateTime @default(now())
  expiraEm DateTime

  doacao Doacao @relation(fields: [doacaoId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
  @@map("comprovantes_entrega")
}

model SaldoCesta {
  id            Int      @id @default(autoincrement())
  instituicaoId Int      @unique
  saldoAtual    Int      @default(0)
  atualizadoEm  DateTime @updatedAt

  movimentacoes MovimentacaoSaldo[]
  instituicao   InstituicaoParceira @relation(fields: [instituicaoId], references: [id])

  @@map("saldos_cesta")
}

model MovimentacaoSaldo {
  id             Int                   @id @default(autoincrement())
  saldoCestaId   Int
  tipo           TipoMovimentacaoSaldo
  quantidade     Int
  saldoAnterior  Int
  saldoPosterior Int
  doacaoId       Int?
  usuarioId      Int
  observacao     String?
  criadoEm       DateTime              @default(now())

  doacao     Doacao?    @relation(fields: [doacaoId], references: [id])
  saldoCesta SaldoCesta @relation(fields: [saldoCestaId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([saldoCestaId, criadoEm])
  @@index([doacaoId])
  @@map("movimentacoes_saldo")
}

model QRCode {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique
  beneficiarioId Int
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])

  @@index([ativo])
  @@index([beneficiarioId])
  @@map("qrcodes")
}

model Comprovante {
  id            Int                  @id @default(autoincrement())
  arquivoUrl    String
  tipoDoc       String
  cnpjExtraido  String?
  status        StatusComprovante    @default(PENDENTE_REVISAO)
  instituicaoId Int?
  instituicao   InstituicaoParceira? @relation(fields: [instituicaoId], references: [id])
  doacaoId      Int?
  doacao        Doacao?              @relation(fields: [doacaoId], references: [id])
  criadoEm      DateTime             @default(now())
  revisadoEm    DateTime?

  @@index([instituicaoId])
  @@index([status])
  @@map("comprovantes")
}

model Notificacao {
  id             Int                  @id @default(autoincrement())
  instituicaoId  Int?
  instituicao    String
  assunto        String
  descricao      String
  mensagem       String?
  tipo           String               @default("MENSAGEM")
  destinatario   String?
  remetente      String?
  lida           Boolean              @default(false)
  criadoEm       DateTime             @default(now())
  atualizadoEm   DateTime             @updatedAt
  instituicaoRef InstituicaoParceira? @relation(fields: [instituicaoId], references: [id], onDelete: SetNull)
  doacao         Doacao?              @relation(fields: [doacaoId], references: [id])
  doacaoId       Int?

  @@index([instituicaoId, criadoEm])
  @@index([lida, criadoEm])
  @@index([instituicao, criadoEm])
  @@map("notificacoes")
}


model ChamadoSuporte {
  id            Int                    @id @default(autoincrement())
  instituicaoId Int
  assunto       String
  categoria     CategoriaChamadoSuporte
  status        StatusChamadoSuporte   @default(ABERTO)
  criadoPorNome String
  criadoEm      DateTime               @default(now())
  atualizadoEm  DateTime               @updatedAt
  resolvidoEm   DateTime?

  instituicao InstituicaoParceira @relation(fields: [instituicaoId], references: [id])
  mensagens   MensagemSuporte[]

  @@index([instituicaoId, atualizadoEm])
  @@index([status, atualizadoEm])
  @@map("chamados_suporte")
}

model MensagemSuporte {
  id         Int         @id @default(autoincrement())
  chamadoId  Int
  autorRole  RoleUsuario
  autorNome  String
  mensagem   String
  lida       Boolean     @default(false)
  criadoEm   DateTime    @default(now())

  chamado ChamadoSuporte @relation(fields: [chamadoId], references: [id], onDelete: Cascade)

  @@index([chamadoId, criadoEm])
  @@index([lida, criadoEm])
  @@map("mensagens_suporte")
}

enum CategoriaChamadoSuporte {
  ALTERACAO_CADASTRAL
  DUVIDA
  PROBLEMA_TECNICO
  OUTRO
}

enum StatusChamadoSuporte {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_INSTITUICAO
  RESOLVIDO
}

enum RoleUsuario {
  ADMIN
  INSTITUICAO
}

enum TipoInstituicao {
  IGREJA
  ASSOCIACAO
  ONG
  OUTRO
}

enum StatusInstituicao {
  OK
  PENDENTE
}

enum TipoBeneficio {
  CESTA
  GRANEL
  AMBOS
  OUTROS
}

enum TipoEventoHistorico {
  CADASTRO
  ATUALIZACAO
  DOACAO
}

enum TipoMovimentacaoSaldo {
  ENTRADA
  SAIDA_DOACAO
  ESTORNO_DOACAO
}

enum StatusComprovante {
  VINCULADO
  PENDENTE_REVISAO
  REJEITADO
}
